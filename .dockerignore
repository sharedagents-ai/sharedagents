# Keep the build context small and secrets out of the image.
.git
.github
.worktrees
.claude
**/.env
**/.env.*
*.log
.envrc

# Python build cruft.
**/__pycache__
**/*.py[co]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/*.egg-info
build/
dist/
.venv
venv

# Not needed to run the stack.
tests/
docs/

# Editor / OS junk.
.idea
.vscode
.DS_Store
*.swp
