# Top-level dev config — only the repo-root file, not any package-level
# `config.py` modules. The unanchored pattern (just `config.py`) used to
# silently kill `src/sharedagents/config.py` and `src/sharedagents_agent/config.py`,
# leaving the codebase in a broken state where tests imported from
# nonexistent modules.
/config.py

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

