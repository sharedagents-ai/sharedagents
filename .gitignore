tests/reports/

# Claude Code scheduled-task lockfile rule removed: covered by the
# `.claude/*` + `!.claude/skills/` block below (directory-level `.claude/`
# would defeat the skills re-include — git never descends into an ignored dir).

# Git worktrees (per the using-git-worktrees skill)
.worktrees/

# Claude Code local working dir (worktrees, settings).
# `.claude/*` rather than `.claude/` so the negation below can re-include a child:
# git never descends into a directory excluded with a trailing slash.
.claude/*

# ...except project skills. A skill is a shared configuration item — it travels with the
# repo, it is reviewed, and it is edited via branch + PR like anything else here. Local
# settings (settings.local.json, the task lockfile) stay ignored by the rule above.
!.claude/skills/

# Coder profile template lives under profile_agents/build/ — not a build-output dir
!src/sharedagents_agent/profile_agents/build/
!src/sharedagents_agent/profile_agents/build/AGENTS.md
!src/sharedagents_core/profile_agents/build/
!src/sharedagents_core/profile_agents/build/AGENTS.md

# Local deployment/ops config — intentionally not in the repo. Kept out of
# version control so machine-specific compose files and their secrets (e.g. a
# telegram-bot-api .env with API_ID/API_HASH) can never be committed.
deploy/
/review/
ui_ws_sent.png
/venv
